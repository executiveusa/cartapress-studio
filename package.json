{
  "name": "cartapress-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent-ready restaurant menu design studio",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node mcp/server.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "ops:once": "node ops/runner.mjs",
    "ops:loop": "node ops/runner.mjs --loop",
    "ops:smoke": "node --test tests/ops.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
